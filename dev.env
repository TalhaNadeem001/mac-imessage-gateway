# Local development — sourced by dev.sh (safe to commit; no real secrets)
IMESSAGE_API_KEY=dev-local-key
IMESSAGE_USER_ID=dev-user
IMESSAGE_HOST=127.0.0.1
IMESSAGE_PORT=8000

# Test harness webhook (test/server.py)
TEST_HOST=127.0.0.1
TEST_PORT=9000
FWD_URL=http://127.0.0.1:9000/webhook

# Faster feedback while developing
INBOUND_BATCH_DELAY_SECONDS=0
LOG_LEVEL=DEBUG

IMESSAGE_DB_PATH=./db/dev_chat.db
